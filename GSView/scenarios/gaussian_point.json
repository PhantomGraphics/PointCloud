{
  "name": "gaussian_point",
  "steps": [
    { "label": "GaussianPoint renderer initialised",
      "command": "GetGaussianPointAvailable",
      "expect": "Val:1" },
    { "label": "Load gs_sphere (DC-only synthetic data)",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "SH degree of the data is 0",
      "command": "GetGpShDegree",
      "expect": "Val:0" },
    { "label": "SPP = 4",
      "command": "SetGpSpp:4",
      "expect": "OK" },
    { "label": "Frame-varying seed so progressive accumulation converges",
      "command": "SetGpSeedMode:frame",
      "expect": "OK" },
    { "label": "Density scale = 1",
      "command": "SetGpDensityScale:1",
      "expect": "OK" },
    { "label": "Switch to GaussianPoint",
      "command": "SetRenderMode:GaussianPoint",
      "expect": "OK" },
    { "label": "Mode is GaussianPoint",
      "command": "GetRenderMode",
      "expect": "Val:GaussianPoint" },
    { "label": "let it accumulate", "command": "GetStatus", "expect": "OK", "repeat": 30 },
    { "label": "Points were generated",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "Progressive accumulation has built up frames",
      "command": "GetGpAccumFrames",
      "store_as": "accum_hi", "strip_prefix": "Val:",
      "expect_prefix": "Val:", "expect_not": "Val:1" },
    { "label": "Stats line is well formed",
      "command": "GetGpStats",
      "expect_prefix": "Expected:" },
    { "label": "Converged baseline screenshot",
      "command": "Screenshot:${repo_root}/screenshots/gsview_gaussian_point.png",
      "expect_prefix": "OK:" },
    { "label": "Change density -> accumulation must restart (no stale history)",
      "command": "SetGpDensityScale:1.5",
      "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "Accumulation reset after the parameter change",
      "command": "GetGpAccumFrames",
      "store_as": "accum_lo", "strip_prefix": "Val:",
      "expect_prefix": "Val:" },
    { "label": "Tone-map + gamma controls accepted",
      "command": "SetGpTonemap:aces",
      "expect": "OK" },
    { "label": "Gamma control accepted",
      "command": "SetGpGamma:2.2",
      "expect": "OK" },
    { "label": "SH degree > data is rejected",
      "command": "SetGpShDegree:5",
      "expect_prefix": "Error:" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ],
  "post_assert": "accum_hi > accum_lo"
}
