{
  "name": "params_pbvr",
  "steps": [
    { "label": "Load sphere for PBVR params",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:" },
    { "label": "Switch to PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "Set density scale to 2",
      "command": "SetDensityScale:2",
      "expect": "OK" },
    { "label": "Get density scale is 2",
      "command": "GetDensityScale",
      "expect": "Val:2" },
    { "label": "Set max particles per splat to 128",
      "command": "SetMaxParticlesPerSplat:128",
      "expect": "OK" },
    { "label": "Get max particles per splat is 128",
      "command": "GetMaxParticlesPerSplat",
      "expect": "Val:128" },
    { "label": "Method defaults to proportional",
      "command": "GetPbvr3dMethod",
      "expect": "Val:proportional" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 6 },
    { "label": "Particles exist after param change",
      "command": "GetParticleCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "Capacity is reported and non-zero",
      "command": "GetParticleCapacity",
      "expect_prefix": "Count:", "expect_not": "Count:0" }
  ]
}
