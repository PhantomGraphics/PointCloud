{
  "name": "pbvr3d_modes",
  "post_assert": "vc_gen < ext_gen",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Frame-varying seed (sample-set averaging)",
      "command": "SetGpSeedMode:frame",
      "expect": "OK" },
    { "label": "SPP = 4",
      "command": "SetGpSpp:4",
      "expect": "OK" },
    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },

    { "label": "Method: proportional",
      "command": "SetPbvr3dMethod:proportional",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 8 },
    { "label": "proportional produces particles",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "prop_gen", "strip_prefix": "Count:" },
    { "label": "proportional stats", "command": "GetGpStats", "expect_prefix": "Expected:" },

    { "label": "Method: extinction",
      "command": "SetPbvr3dMethod:extinction",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 8 },
    { "label": "extinction produces particles",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "ext_gen", "strip_prefix": "Count:" },
    { "label": "extinction stats", "command": "GetGpStats", "expect_prefix": "Expected:" },

    { "label": "Method: view-conditioned (GPS-calibrated)",
      "command": "SetPbvr3dMethod:view_conditioned",
      "expect": "OK" },
    { "label": "Method reads back",
      "command": "GetPbvr3dMethod",
      "expect": "Val:view_conditioned" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 8 },
    { "label": "view-conditioned produces particles",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "vc_gen", "strip_prefix": "Count:" },
    { "label": "view-conditioned stats", "command": "GetGpStats", "expect_prefix": "Expected:" },

    { "label": "Reference: GaussianPoint (GPS) on the same scene",
      "command": "SetRenderMode:GaussianPoint",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 8 },
    { "label": "GaussianPoint reference count",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gps_gen", "strip_prefix": "Count:" },

    { "label": "PBVR3D comparison screenshot (view-conditioned)",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 12 },
    { "label": "screenshot",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_view_conditioned.png",
      "expect_prefix": "OK:" },
    { "label": "App healthy after cycling all methods",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
