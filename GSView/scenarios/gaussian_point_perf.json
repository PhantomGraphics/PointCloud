{
  "name": "gaussian_point_perf",
  "post_assert": "gen_budgeted < gen_full",
  "steps": [
    { "label": "Load the large scene (~15000 splats)",
      "command": "LoadPLY:../samples/gs/gs_large_scene.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "GaussianPoint, frame-varying",
      "command": "SetRenderMode:GaussianPoint",
      "expect": "OK" },
    { "label": "SPP = 4", "command": "SetGpSpp:4", "expect": "OK" },
    { "label": "No budget", "command": "SetGpPointBudget:0", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 12 },
    { "label": "Unbudgeted generated count",
      "command": "GetGpGeneratedCount",
      "store_as": "gen_full", "strip_prefix": "Count:",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "GPU timings are populated",
      "command": "GetGpTimings",
      "expect_prefix": "Compute:" },
    { "label": "Set a 500k point budget",
      "command": "SetGpPointBudget:500000",
      "expect": "OK" },
    { "label": "let the adaptive thinning converge", "command": "GetStatus", "expect": "OK", "repeat": 16 },
    { "label": "Budgeted generated count is lower",
      "command": "GetGpGeneratedCount",
      "store_as": "gen_budgeted", "strip_prefix": "Count:",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "Budget reads back",
      "command": "GetGpPointBudget",
      "expect": "Val:500000" },
    { "label": "Profile line carries the timings",
      "command": "GetGpProfile",
      "expect_prefix": "Profile:gpu=" },
    { "label": "Perf capture",
      "command": "Screenshot:${repo_root}/screenshots/gsview_gaussian_point_perf.png",
      "expect_prefix": "OK:" },
    { "label": "App healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
