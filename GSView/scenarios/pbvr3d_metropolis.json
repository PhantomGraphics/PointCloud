{
  "name": "pbvr3d_metropolis",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "deterministic seed (exact reproducibility for the cross-method comparison below)",
      "command": "SetGpSeedMode:deterministic",
      "expect": "OK" },
    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "start from automatic compact",
      "command": "SetGpCompact:1",
      "expect": "OK" },
    { "label": "camera",
      "command": "SetGpCamera:1.0,0.7,3",
      "expect": "OK" },

    { "label": "Extinction baseline",
      "command": "SetPbvr3dMethod:extinction",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "automatic compact is respected outside Metropolis",
      "command": "GetGpCompactFallback",
      "expect_prefix": "Val:", "expect_not": "Val:2" },
    { "label": "Extinction's generated count (compared against Metropolis below -- both share the same lambda formula and, under deterministic seed, the same per-splat Ni)",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_ext" },

    { "label": "switch to Metropolis",
      "command": "SetPbvr3dMethod:metropolis",
      "expect": "OK" },
    { "label": "reads back",
      "command": "GetPbvr3dMethod",
      "expect": "Val:metropolis" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 4 },
    { "label": "compact fallback confirms the primitive-replay path (this shader's own per-splat loop, where the Metropolis chain lives) is what actually ran, even though automatic compact was requested above",
      "command": "GetGpCompactFallback",
      "expect": "Val:2" },
    { "label": "Metropolis's generated count exactly matches Extinction's under deterministic seed -- same Ni per splat, and every chain accepted all Ni candidates without an early bail-out",
      "command": "GetGpGeneratedCount",
      "expect": "${gen_ext}" },
    { "label": "still drawing real points on screen",
      "command": "GetGpProfile",
      "expect_prefix": "Profile:" },

    { "label": "re-requesting automatic compact while Metropolis is active is silently overridden back to 0 (never a silent wrong-answer combination)",
      "command": "SetGpCompact:1",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "still routed through the primitive-replay path",
      "command": "GetGpCompactFallback",
      "expect": "Val:2" },

    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_metropolis.png",
      "expect_prefix": "OK:" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
