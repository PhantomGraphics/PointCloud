{
  "name": "gaussian_point_footprint",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "deterministic seed", "command": "SetGpSeedMode:deterministic", "expect": "OK" },
    { "label": "GaussianPoint mode", "command": "SetRenderMode:GaussianPoint", "expect": "OK" },
    { "label": "footprint defaults to the GPS point", "command": "GetGpPointFootprint", "expect": "Val:1" },
    { "label": "adaptive footprint defaults to off", "command": "GetGpAdaptiveFootprint", "expect": "Kappa:0,Max:4" },
    { "label": "compensation defaults to off", "command": "GetGpFootprintCompensation", "expect": "Val:0" },
    { "label": "invalid footprint is rejected", "command": "SetGpPointFootprint:0", "expect_prefix": "Error:" },
    { "label": "invalid adaptive setting is rejected", "command": "SetGpAdaptiveFootprint:0.5", "expect_prefix": "Error:" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "GPS point count",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen1", "strip_prefix": "Count:" },
    { "label": "GPS point count (full response)",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "store_as": "gen1_full" },
    { "label": "explicit s=1 is the default", "command": "SetGpPointFootprint:1", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "s=1 is bit-identical", "command": "GetGpGeneratedCount", "expect": "${gen1_full}" },

    { "label": "2x2-subpixel footprint", "command": "SetGpPointFootprint:2", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "fewer points (~1/4, checked by post_assert)",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen2", "strip_prefix": "Count:" },
    { "label": "s=2 count (full)", "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "store_as": "gen2_full" },
    { "label": "s=2 coverage", "command": "GetGpActiveSamples", "expect_prefix": "Val:", "expect_not": "Val:0",
      "store_as": "active2_full" },
    { "label": "primitive replay path", "command": "SetGpCompact:0", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "same points on the primitive path", "command": "GetGpGeneratedCount", "expect": "${gen2_full}" },
    { "label": "same blocks written on the primitive path", "command": "GetGpActiveSamples", "expect": "${active2_full}" },
    { "label": "forced point replay path", "command": "SetGpCompact:2", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "same blocks written on the replay path", "command": "GetGpActiveSamples", "expect": "${active2_full}" },
    { "label": "automatic compact again", "command": "SetGpCompact:1", "expect": "OK" },

    { "label": "blur compensation", "command": "SetGpFootprintCompensation:1", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "compensation moves points, not their number (optical mass is preserved)",
      "command": "GetGpGeneratedCount", "expect": "${gen2_full}" },
    { "label": "compensation off", "command": "SetGpFootprintCompensation:0", "expect": "OK" },

    { "label": "back to s=1", "command": "SetGpPointFootprint:1", "expect": "OK" },
    { "label": "adaptive footprint", "command": "SetGpAdaptiveFootprint:0.4,4", "expect": "OK" },
    { "label": "reads back", "command": "GetGpAdaptiveFootprint", "expect": "Kappa:0.4,Max:4" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "adaptive footprint changes the point count",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "${gen1_full}" },
    { "label": "profile records the footprint", "command": "GetGpProfile", "expect_prefix": "Profile:" },
    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_gaussian_point_footprint.png",
      "expect_prefix": "OK:" },
    { "label": "restore defaults", "command": "SetGpAdaptiveFootprint:0,4", "expect": "OK" },
    { "label": "App still healthy", "command": "GetStatus", "expect": "OK" }
  ],
  "post_assert": "gen2 < gen1"
}
