{
  "name": "pbvr3d_density_clamp",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "deterministic seed (id-only RNG, exactly reproducible per frame -- no frame-varying noise to fight)",
      "command": "SetGpSeedMode:deterministic",
      "expect": "OK" },
    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "density clamp defaults to off (Phase 0, literature-confirmed addition)",
      "command": "GetPbvrDensityClamp",
      "expect": "Val:0" },

    { "label": "Extinction method (unbounded -log(1-op), the branch the clamp targets)",
      "command": "SetPbvr3dMethod:extinction",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "generated count without the clamp",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_ext_off", "strip_prefix": "Count:" },
    { "label": "opt in to the density clamp",
      "command": "SetPbvrDensityClamp:1",
      "expect": "OK" },
    { "label": "reads back",
      "command": "GetPbvrDensityClamp",
      "expect": "Val:1" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "generated count with the clamp -- must be strictly smaller (checked by post_assert)",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_ext_on", "strip_prefix": "Count:" },

    { "label": "View-conditioned shares Extinction's pre-thinning candidate formula, so the clamp reaches it too",
      "command": "SetPbvr3dMethod:view_conditioned",
      "expect": "OK" },
    { "label": "clamp off first",
      "command": "SetPbvrDensityClamp:0",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "generated count without the clamp (kept as the full response for an exact-match comparison below)",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_vc_off_full" },
    { "label": "clamp on",
      "command": "SetPbvrDensityClamp:1",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "generated count changes once the clamp engages for View-conditioned too",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "${gen_vc_off_full}" },

    { "label": "Proportional's op-bounded formula never diverges -- the clamp is exempt (method==0)",
      "command": "SetPbvr3dMethod:proportional",
      "expect": "OK" },
    { "label": "clamp off",
      "command": "SetPbvrDensityClamp:0",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "generated count without the clamp (full response, for an exact-match comparison below)",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_prop_off_full" },
    { "label": "clamp on",
      "command": "SetPbvrDensityClamp:1",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 2 },
    { "label": "generated count is bit-for-bit unchanged -- Proportional is exempt from the clamp",
      "command": "GetGpGeneratedCount",
      "expect": "${gen_prop_off_full}" },

    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_density_clamp.png",
      "expect_prefix": "OK:" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ],
  "post_assert": "gen_ext_on < gen_ext_off"
}
