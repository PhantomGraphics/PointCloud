{
  "name": "pbvr3d_footprint_calibration",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "deterministic seed: counts depend only on splat id and the calibration",
      "command": "SetGpSeedMode:deterministic", "expect": "OK" },
    { "label": "Enter PBVR3DExperimental", "command": "SetRenderMode:PBVR3DExperimental", "expect": "OK" },
    { "label": "Extinction", "command": "SetPbvr3dMethod:extinction", "expect": "OK" },
    { "label": "calibration defaults to C0", "command": "GetPbvrFootprintCalibration", "expect": "Val:0" },
    { "label": "radial correction defaults to off", "command": "GetPbvrRadialCorrection", "expect": "Val:0" },
    { "label": "centre depth defaults to off", "command": "GetPbvrCentreDepth", "expect": "Val:0" },
    { "label": "invalid level is rejected", "command": "SetPbvrFootprintCalibration:4", "expect_prefix": "Error:" },
    { "label": "orbit about gs_sphere's centroid (the renderer's object centre), not the origin",
      "command": "SetGpCameraTarget:-0.02573797,0.00393271,-0.00831146", "expect": "OK" },
    { "label": "camera A", "command": "SetGpCamera:1.2,0.5,3.0", "expect": "OK" },
    { "label": "small reference pixel length so C1/C2 counts stay below maxPointsPerSplat (a clamped count cannot respond to the view)",
      "command": "SetPbvrReferencePixelLength:0.002", "expect": "OK" },

    { "label": "legacy zoom switch (C1)", "command": "SetPbvrZoom:1", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C1 count via the legacy switch",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_zoom_full" },
    { "label": "legacy switch off", "command": "SetPbvrZoom:0", "expect": "OK" },
    { "label": "same level through the new parameter", "command": "SetPbvrFootprintCalibration:object_zoom", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C1 is exactly the legacy zoom recalibration",
      "command": "GetGpGeneratedCount", "expect": "${gen_zoom_full}" },
    { "label": "orbit to camera B (same distance to the object centre)", "command": "SetGpCamera:1.2,2.0,3.0", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C1 does not respond to an orbit about the object centre",
      "command": "GetGpGeneratedCount", "expect": "${gen_zoom_full}" },

    { "label": "C2 per-splat depth", "command": "SetPbvrFootprintCalibration:per_splat_depth", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C2 count at camera B",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_c2_b" },
    { "label": "back to camera A", "command": "SetGpCamera:1.2,0.5,3.0", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C2 responds to the orbit (each splat's own depth moves)",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "${gen_c2_b}" },

    { "label": "C3 per-splat footprint", "command": "SetPbvrFootprintCalibration:per_splat_footprint", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C3 Extinction candidates",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_c3", "strip_prefix": "Count:" },
    { "label": "C3+R", "command": "SetPbvrRadialCorrection:1", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "C3+R keeps a subset (checked by post_assert)",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_c3r", "strip_prefix": "Count:" },
    { "label": "C3+R count, full response for the path comparison",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "store_as": "gen_c3r_full" },
    { "label": "primitive replay path", "command": "SetGpCompact:0", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "primitive replay draws the same C3+R particles as the compact path",
      "command": "GetGpGeneratedCount", "expect": "${gen_c3r_full}" },
    { "label": "compact path again", "command": "SetGpCompact:1", "expect": "OK" },

    { "label": "Proportional", "command": "SetPbvr3dMethod:proportional", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "Proportional C3 with the radial switch on",
      "command": "GetGpGeneratedCount", "expect_prefix": "Count:", "store_as": "gen_prop_radial_full" },
    { "label": "radial off", "command": "SetPbvrRadialCorrection:0", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "the radial correction only applies to Extinction",
      "command": "GetGpGeneratedCount", "expect": "${gen_prop_radial_full}" },

    { "label": "splat-centre depth", "command": "SetPbvrCentreDepth:1", "expect": "OK" },
    { "label": "reads back", "command": "GetPbvrCentreDepth", "expect": "Val:1" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "depth rule changes only the depth keys, not the particle count",
      "command": "GetGpGeneratedCount", "expect": "${gen_prop_radial_full}" },
    { "label": "profile records the calibration", "command": "GetGpProfile", "expect_prefix": "Profile:" },
    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_footprint_calibration.png",
      "expect_prefix": "OK:" },

    { "label": "restore defaults", "command": "SetGpCameraTarget:0,0,0", "expect": "OK" },
    { "label": "restore defaults", "command": "SetPbvrCentreDepth:0", "expect": "OK" },
    { "label": "restore defaults", "command": "SetPbvrFootprintCalibration:none", "expect": "OK" },
    { "label": "App still healthy", "command": "GetStatus", "expect": "OK" }
  ],
  "post_assert": "gen_c3r < gen_c3"
}
