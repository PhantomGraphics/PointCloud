{
  "name": "pbvr3d_bank_reuse_view_drift",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Frame-varying seed",
      "command": "SetGpSeedMode:frame",
      "expect": "OK" },
    { "label": "SPP = 4",
      "command": "SetGpSpp:4",
      "expect": "OK" },
    { "label": "Automatic compact (required for bank reuse)",
      "command": "SetGpCompact:1",
      "expect": "OK" },
    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "view-conditioned method",
      "command": "SetPbvr3dMethod:view_conditioned",
      "expect": "OK" },

    { "label": "initial camera",
      "command": "SetGpCamera:1.0,0.7,3",
      "expect": "OK" },
    { "label": "render frames at the initial camera",
      "command": "GetStatus", "expect": "OK", "repeat": 6 },

    { "label": "opt in to bank reuse",
      "command": "SetPbvrBankReuse:1",
      "expect": "OK" },
    { "label": "settle at a fixed camera so the bank gets generated and confirmed",
      "command": "GetStatus", "expect": "OK", "repeat": 6 },

    { "label": "orbit 1 (camera-only change)", "command": "SetGpCamera:1.1,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 2", "command": "SetGpCamera:1.2,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 3", "command": "SetGpCamera:1.3,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 4 (both frame-in-flight slots should have a confirmed bank by now)",
      "command": "SetGpCamera:1.4,0.7,3", "expect": "OK" },
    { "label": "bank is reused before any dolly (baseline, matches pbvr3d_bank_reuse.json)",
      "command": "GetGpBankReused",
      "expect": "Val:1" },

    { "label": "dolly 1 (distance-only camera-only change, same theta/phi)",
      "command": "SetGpCamera:1.4,0.7,4", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "dolly 2", "command": "SetGpCamera:1.4,0.7,5", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "dolly 3", "command": "SetGpCamera:1.4,0.7,6", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "dolly 4 (distance 3 -> 7, +133% vs. the reference captured at distance 3)",
      "command": "SetGpCamera:1.4,0.7,7", "expect": "OK" },
    { "label": "ViewConditioned drift check disqualifies reuse past the tolerance",
      "command": "GetGpBankReused",
      "expect": "Val:0" },
    { "label": "the drift-blocked frame still fell back to full regeneration, not a stall",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },

    { "label": "switch to proportional (hard reset; view-independent candidate count)",
      "command": "SetPbvr3dMethod:proportional",
      "expect": "OK" },
    { "label": "settle at distance 7 so the bank gets generated and confirmed",
      "command": "GetStatus", "expect": "OK", "repeat": 6 },

    { "label": "orbit 1'", "command": "SetGpCamera:1.5,0.7,7", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 2'", "command": "SetGpCamera:1.6,0.7,7", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 3'", "command": "SetGpCamera:1.7,0.7,7", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 4'", "command": "SetGpCamera:1.8,0.7,7", "expect": "OK" },
    { "label": "bank is reused before any dolly, under proportional",
      "command": "GetGpBankReused",
      "expect": "Val:1" },

    { "label": "dolly 1' (proportional: same large-dolly magnitude as the blocked ViewConditioned case)",
      "command": "SetGpCamera:1.8,0.7,9", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "dolly 2'", "command": "SetGpCamera:1.8,0.7,12", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "dolly 3'", "command": "SetGpCamera:1.8,0.7,15", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "dolly 4' (distance 7 -> 18, +157%)",
      "command": "SetGpCamera:1.8,0.7,18", "expect": "OK" },
    { "label": "Proportional is exempt from the ViewConditioned drift check: still reused",
      "command": "GetGpBankReused",
      "expect": "Val:1" },

    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_bank_reuse_view_drift.png",
      "expect_prefix": "OK:" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
