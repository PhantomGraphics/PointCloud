{
  "name": "pbvr3d_bank_reuse_multi_ensemble",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Frame-varying seed",
      "command": "SetGpSeedMode:frame",
      "expect": "OK" },
    { "label": "SPP = 4",
      "command": "SetGpSpp:4",
      "expect": "OK" },
    { "label": "Automatic compact (required for bank reuse)",
      "command": "SetGpCompact:1",
      "expect": "OK" },
    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "proportional method (view-independent candidate count, no drift check involved)",
      "command": "SetPbvr3dMethod:proportional",
      "expect": "OK" },

    { "label": "Manual LOD, R = 4 ensembles/frame, a target far above what a few orbit frames reach",
      "command": "SetGpLodMode:manual",
      "expect": "OK" },
    { "label": "ensemblesPerFrame = 4",
      "command": "SetGpEnsemblesPerFrame:4",
      "expect": "OK" },
    { "label": "targetEnsembles = 200",
      "command": "SetGpTargetEnsembles:200",
      "expect": "OK" },

    { "label": "initial camera",
      "command": "SetGpCamera:1.0,0.7,3",
      "expect": "OK" },
    { "label": "settle at a fixed camera: drains the Manual-mode hard reset, confirms a bank in both frame-in-flight slots",
      "command": "GetStatus", "expect": "OK", "repeat": 8 },
    { "label": "stationary: R still runs at the full Manual request, never a reuse frame (Displayed keeps climbing towards target -- only ThisFrame/BankReused are asserted exactly here)",
      "command": "GetGpBankReuseStats",
      "expect_prefix": "BankReused:0,ThisFrame:4" },

    { "label": "camera-only reset with bank reuse still off: R=4 is unaffected by the (unused) reuse machinery",
      "command": "SetGpCamera:1.05,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "R=4 still dispatched on a reset frame even without opting in; reuse stays off without opt-in",
      "command": "GetGpBankReuseStats",
      "expect_prefix": "BankReused:0,ThisFrame:4" },
    { "label": "settle again before opting in",
      "command": "GetStatus", "expect": "OK", "repeat": 3 },

    { "label": "opt in to bank reuse",
      "command": "SetPbvrBankReuse:1",
      "expect": "OK" },
    { "label": "settle so both slots hold a confirmed bank under reuse",
      "command": "GetStatus", "expect": "OK", "repeat": 6 },
    { "label": "still stationary: no reset pending yet, so no reuse",
      "command": "GetGpBankReuseStats",
      "expect_prefix": "BankReused:0,ThisFrame:4" },

    { "label": "orbit 1 (camera-only change, Manual R=4)", "command": "SetGpCamera:1.1,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 2", "command": "SetGpCamera:1.2,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 3", "command": "SetGpCamera:1.3,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 4 (both frame-in-flight slots should have a confirmed bank by now)",
      "command": "SetGpCamera:1.4,0.7,3", "expect": "OK" },

    { "label": "reset frame's first ensemble reprojects the bank; the other 3 requested ensembles still ran genuine independent draws (ThisFrame=4); the reset slot's history holds exactly R=4 -- the reused bank counted once, not zero and not inflated",
      "command": "GetGpBankReuseStats",
      "expect": "BankReused:1,ThisFrame:4,Displayed:4" },
    { "label": "the 3 regenerating ensembles produced real candidates, not just the reprojected ones",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },

    { "label": "orbit 5 (continuous orbiting keeps re-triggering the same connected reuse)", "command": "SetGpCamera:1.5,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 6", "command": "SetGpCamera:1.6,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 7", "command": "SetGpCamera:1.7,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 8", "command": "SetGpCamera:1.8,0.7,3", "expect": "OK" },
    { "label": "history resets to exactly R=4 again on every fresh reset frame -- never cumulative across resets",
      "command": "GetGpBankReuseStats",
      "expect": "BankReused:1,ThisFrame:4,Displayed:4" },

    { "label": "camera settles (orbiting stops)", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "settle drains the transient reset window", "command": "GetStatus", "expect": "OK", "repeat": 4 },
    { "label": "stationary again: no longer reuses, but Manual R=4 still runs in full",
      "command": "GetGpBankReuseStats",
      "expect_prefix": "BankReused:0,ThisFrame:4" },

    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_bank_reuse_multi_ensemble.png",
      "expect_prefix": "OK:" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
