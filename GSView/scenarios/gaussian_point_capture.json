{
  "name": "gaussian_point_capture",
  "steps": [
    { "label": "GaussianPoint available",
      "command": "GetGaussianPointAvailable",
      "expect": "Val:1" },
    { "label": "Load the stress scene",
      "command": "LoadPLY:../samples/gs/gs_stress.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Deterministic seed for a reproducible baseline",
      "command": "SetGpSeedMode:deterministic",
      "expect": "OK" },
    { "label": "SPP = 4",
      "command": "SetGpSpp:4",
      "expect": "OK" },
    { "label": "GaussianPoint mode",
      "command": "SetRenderMode:GaussianPoint",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 12 },
    { "label": "Stress scene still produces particles (no crash on edge cases)",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "Profile line is well formed",
      "command": "GetGpProfile",
      "expect_prefix": "Profile:gpu=" },
    { "label": "Baseline capture + sidecar JSON",
      "command": "Screenshot:${repo_root}/screenshots/gsview_gaussian_point_stress.png",
      "expect_prefix": "OK:" },
    { "label": "GaussianPoint on gs_sphere for the reference capture",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:" },
    { "label": "frame-varying + converge",
      "command": "SetGpSeedMode:frame",
      "expect": "OK" },
    { "label": "converge", "command": "GetStatus", "expect": "OK", "repeat": 40 },
    { "label": "Converged reference capture + sidecar",
      "command": "Screenshot:${repo_root}/screenshots/gsview_gaussian_point_ref.png",
      "expect_prefix": "OK:" },
    { "label": "App healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
