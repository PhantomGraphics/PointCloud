{
  "name": "camera_flip_y",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "GaussianPoint mode",
      "command": "SetRenderMode:GaussianPoint",
      "expect": "OK" },
    { "label": "camera up defaults to +Y",
      "command": "GetCameraFlipY",
      "expect": "Val:0" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "flip to Y-down (3DGS/COLMAP data)",
      "command": "SetCameraFlipY:1",
      "expect": "OK" },
    { "label": "reads back",
      "command": "GetCameraFlipY",
      "expect": "Val:1" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "flipping the view restarts accumulation like any camera move",
      "command": "GetGpAccumFrames",
      "expect_prefix": "Val:", "expect_not": "Val:0" },
    { "label": "profile records the flip",
      "command": "GetGpProfile",
      "expect_prefix": "Profile:" },
    { "label": "invalid value is rejected",
      "command": "SetCameraFlipY:2",
      "expect_prefix": "Error:" },
    { "label": "flipped screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_camera_flip_y.png",
      "expect_prefix": "OK:" },
    { "label": "restore +Y up",
      "command": "SetCameraFlipY:0",
      "expect": "OK" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
