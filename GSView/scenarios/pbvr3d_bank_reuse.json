{
  "name": "pbvr3d_bank_reuse",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Frame-varying seed",
      "command": "SetGpSeedMode:frame",
      "expect": "OK" },
    { "label": "SPP = 4",
      "command": "SetGpSpp:4",
      "expect": "OK" },
    { "label": "Automatic compact (required for bank reuse)",
      "command": "SetGpCompact:1",
      "expect": "OK" },
    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "view-conditioned method",
      "command": "SetPbvr3dMethod:view_conditioned",
      "expect": "OK" },
    { "label": "Bank reuse defaults to off (Phase 4)",
      "command": "GetPbvrBankReuse",
      "expect": "Val:0" },
    { "label": "no bank reuse before opt-in",
      "command": "GetGpBankReused",
      "expect": "Val:0" },

    { "label": "initial camera",
      "command": "SetGpCamera:1.0,0.7,3",
      "expect": "OK" },
    { "label": "render frames at the initial camera",
      "command": "GetStatus", "expect": "OK", "repeat": 6 },
    { "label": "camera-only moves still never reuse without opt-in",
      "command": "SetGpCamera:1.05,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "reuse stays off without opt-in",
      "command": "GetGpBankReused",
      "expect": "Val:0" },

    { "label": "opt in to bank reuse",
      "command": "SetPbvrBankReuse:1",
      "expect": "OK" },
    { "label": "reads back",
      "command": "GetPbvrBankReuse",
      "expect": "Val:1" },
    { "label": "settle at a fixed camera so the bank gets generated and confirmed",
      "command": "GetStatus", "expect": "OK", "repeat": 6 },
    { "label": "no camera change yet: still not a reuse frame",
      "command": "GetGpBankReused",
      "expect": "Val:0" },

    { "label": "orbit 1 (camera-only change)", "command": "SetGpCamera:1.1,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 2", "command": "SetGpCamera:1.2,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 3", "command": "SetGpCamera:1.3,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "orbit 4 (both frame-in-flight slots should have a confirmed bank by now)",
      "command": "SetGpCamera:1.4,0.7,3", "expect": "OK" },

    { "label": "bank is reused during continuous camera-only orbit",
      "command": "GetGpBankReused",
      "expect": "Val:1" },
    { "label": "reused-bank particles are still being drawn",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },

    { "label": "camera settles (orbit stops): next frame is the last reuse, then genuine refinement resumes",
      "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "stationary frame (no new camera change) no longer reuses",
      "command": "GetGpBankReused",
      "expect": "Val:0" },

    { "label": "zoom recalibration disables reuse (density becomes distance-dependent)",
      "command": "SetPbvrZoom:1", "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "orbit with zoom recalibration on", "command": "SetGpCamera:1.5,0.7,3", "expect": "OK" },
    { "label": "one frame", "command": "GetStatus", "expect": "OK", "repeat": 1 },
    { "label": "reuse is disabled while zoom recalibration is on",
      "command": "GetGpBankReused",
      "expect": "Val:0" },
    { "label": "zoom recalibration off again",
      "command": "SetPbvrZoom:0", "expect": "OK" },

    { "label": "screenshot for visual sanity",
      "command": "Screenshot:${repo_root}/screenshots/gsview_pbvr3d_bank_reuse.png",
      "expect_prefix": "OK:" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
