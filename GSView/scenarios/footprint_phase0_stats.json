{
  "name": "footprint_phase0_stats",
  "steps": [
    { "label": "Load gs_sphere",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "deterministic seed so counts are exactly reproducible",
      "command": "SetGpSeedMode:deterministic",
      "expect": "OK" },

    { "label": "GaussianPoint mode",
      "command": "SetRenderMode:GaussianPoint",
      "expect": "OK" },
    { "label": "profile variant defaults to 0 (normal rendering)",
      "command": "GetGpProfileVariant",
      "expect": "Val:0" },
    { "label": "out-of-range variant is rejected",
      "command": "SetGpProfileVariant:4",
      "expect_prefix": "Error:" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "timings expose the prepare/scan subdivision",
      "command": "GetGpTimings",
      "expect_prefix": "Compute:", "expect_not": "Error" },
    { "label": "generated count, normal variant",
      "command": "GetGpGeneratedCount",
      "expect_prefix": "Count:", "expect_not": "Count:0",
      "store_as": "gen_v0_full" },
    { "label": "normal rendering covers subpixels",
      "command": "GetGpActiveSamples",
      "expect_prefix": "Val:", "expect_not": "Val:0" },

    { "label": "variant 1: skip atomics",
      "command": "SetGpProfileVariant:1",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "same generated count -- sampling is unchanged, only the writes are skipped",
      "command": "GetGpGeneratedCount",
      "expect": "${gen_v0_full}" },
    { "label": "nothing is written, so nothing is covered",
      "command": "GetGpActiveSamples",
      "expect": "Val:0" },

    { "label": "variant 2: cheap radius",
      "command": "SetGpProfileVariant:2",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "same generated count -- per-splat Poisson count does not depend on the radius sampler",
      "command": "GetGpGeneratedCount",
      "expect": "${gen_v0_full}" },

    { "label": "back to normal rendering",
      "command": "SetGpProfileVariant:0",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "coverage restored",
      "command": "GetGpActiveSamples",
      "expect_prefix": "Val:", "expect_not": "Val:0" },

    { "label": "Enter PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "Proportional never computes a GPS target",
      "command": "SetPbvr3dMethod:proportional",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "keep-saturated count is 0 outside ViewConditioned",
      "command": "GetGpKeepSaturated",
      "expect": "Val:0" },
    { "label": "ViewConditioned",
      "command": "SetPbvr3dMethod:view_conditioned",
      "expect": "OK" },
    { "label": "starve the candidate set (basePointsPerSplat = 1) so the GPS target exceeds it",
      "command": "SetPbvrParticleSize:0.015625",
      "expect": "OK" },
    { "label": "settle", "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "label": "starved candidates -> saturated splats are reported",
      "command": "GetGpKeepSaturated",
      "expect_prefix": "Val:", "expect_not": "Val:0" },
    { "label": "profile line carries the new fields",
      "command": "GetGpProfile",
      "expect_prefix": "Profile:" },

    { "label": "eye-fixed yaw support: move the orbit target",
      "command": "SetGpCameraTarget:0.25,0,-0.1",
      "expect": "OK" },
    { "label": "malformed target is rejected",
      "command": "SetGpCameraTarget:1,2",
      "expect_prefix": "Error:" },
    { "label": "restore the default target",
      "command": "SetGpCameraTarget:0,0,0",
      "expect": "OK" },
    { "label": "App still healthy",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
