{
  "name": "reload_same_count",
  "post_assert": "gen_after > gen_before",
  "steps": [
    { "label": "Load gs_sphere (2000 splats)",
      "command": "LoadPLY:../samples/gs/gs_sphere.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Splat count is 2000",
      "command": "GetSplatCount",
      "expect": "Count:2000" },
    { "label": "Record data generation before reload",
      "command": "GetDataGeneration",
      "expect_prefix": "Val:",
      "store_as": "gen_before", "strip_prefix": "Val:" },
    { "label": "Switch to PBVR3DExperimental",
      "command": "SetRenderMode:PBVR3DExperimental",
      "expect": "OK" },
    { "label": "Particles generated for first sphere",
      "command": "GetParticleCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "Load gs_sphere_b -- same 2000 splat count, different geometry",
      "command": "LoadPLY:../samples/gs/gs_sphere_b.ply",
      "expect_prefix": "OK:", "expect_not": "OK:0" },
    { "label": "Splat count still 2000",
      "command": "GetSplatCount",
      "expect": "Count:2000" },
    { "label": "Data generation advanced on same-count reload",
      "command": "GetDataGeneration",
      "expect_prefix": "Val:",
      "store_as": "gen_after", "strip_prefix": "Val:" },
    { "label": "Particles regenerated for the new sphere",
      "command": "GetParticleCount",
      "expect_prefix": "Count:", "expect_not": "Count:0" },
    { "label": "App still healthy after same-count reload",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
