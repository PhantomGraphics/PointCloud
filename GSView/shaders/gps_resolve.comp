#version 450

// GaussianPoint -- resolve + progressive accumulation.
// Average the spp subpixel samples of each pixel in LINEAR space (a covered
// subpixel contributes its stored colour, an empty one the background), then
// fold that frame's estimate into a per-frame-in-flight accumulator. Each
// accumulator is written only by frames of one parity, so the two frames in
// flight never race on it. resetAccum starts a fresh average.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 1) readonly buffer DepthB { uint  depthBuf[]; };
layout(std430, binding = 2) readonly buffer ColorB { uvec2 colorBuf[]; };
layout(std430, binding = 3)          buffer AccumB { vec4  accumBuf[]; };  // rgb sum, sample count
layout(std430, binding = 4)          buffer StatsB { uint  stats[]; };

layout(std140, binding = 5) uniform Params {
    mat4  view;
    vec4  p0;
    vec4  p1;
    uvec4 dims;   // width, height, spp, sppSide
    uvec4 ctrl;
    vec4  p2;
    vec4  bg;
    vec4  camPos;
    uvec4 ctrl2;  // resetAccum, shDegree, tonemapMode, unused
    vec4  p3;
} u;

vec3 unpackColor(uvec2 c) {
    vec2 rg = unpackHalf2x16(c.x);
    vec2 b0 = unpackHalf2x16(c.y);
    return vec3(rg, b0.x);
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= u.dims.x || gid.y >= u.dims.y) return;

    uint spp  = u.dims.z;
    uint base = (gid.y * u.dims.x + gid.x) * spp;

    vec3 acc = vec3(0.0);
    uint covered = 0u;
    for (uint s = 0u; s < spp; ++s) {
        if (depthBuf[base + s] != 0xFFFFFFFFu) {
            acc += unpackColor(colorBuf[base + s]);
            covered++;
        }
    }

    vec3 frame = (acc + float(spp - covered) * u.bg.rgb) / float(spp);

    uint pix = gid.y * u.dims.x + gid.x;
    if (u.ctrl2.x != 0u) {
        accumBuf[pix] = vec4(frame, 1.0);
    } else {
        vec4 a = accumBuf[pix];
        accumBuf[pix] = vec4(a.rgb + frame, a.a + 1.0);
    }

    if (covered > 0u) atomicAdd(stats[2], covered);
}
