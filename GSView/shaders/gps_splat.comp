#version 450
#extension GL_GOOGLE_include_directive : require
#include "gps_work.glsl"

// GaussianPoint -- fused project + count + splat, run twice via a push constant:
// pass 0 writes nearest depth (atomicMin on a uint32 key), pass 1 writes the
// winning colour (logarithmic HDR uint, guarded by an exact depth-key match).
// A second atomicMin resolves exact depth ties deterministically without needing
// shaderBufferInt64Atomics. See docs/todo/PLAN_gsview_gaussian_point_pbvr.md.
// Colour is evaluated in LINEAR space (SH, 3DGS eval_sh) -- tone mapping / gamma
// happen once at composite. The maths mirrors GSView/GaussianPointMath.cpp.

layout(local_size_x = 64) in;

struct GsPoint {
    float x, y, z;
    float nx, ny, nz;
    float f0, f1, f2;
    float opacity;
    float s0, s1, s2;
    float r0, r1, r2, r3;
};
layout(std430, binding = 0) readonly buffer InBuf   { GsPoint splats[]; };
layout(std430, binding = 1)          buffer DepthB  { uint  depthBuf[]; };
layout(std430, binding = 2)          buffer ColorB  { uint colorBuf[]; };  // deterministic logarithmic 11/11/10-bit HDR
layout(std430, binding = 4)          buffer StatsB  { uint  stats[]; };     // 0:expected*256 1:generated 2:active 3:drawn 4:candidates 5:accum sets 6:expected overflow 7:ViewConditioned keep-saturated
layout(std430, binding = 6) readonly buffer ShRestB { float shRest[]; };

layout(std140, binding = 5) uniform Params {
    mat4  view;    // world -> camera (GLM convention: camera looks -Z)
    vec4  p0;      // focalX, focalY, cx, cy        (pixels)
    vec4  p1;      // nearZ, lowPass, shC0, opacityCutoff
    uvec4 dims;    // width, height, spp, sppSide
    uvec4 ctrl;    // numSplats, frameIndex, seedMode, countMode
    vec4  p2;      // maxPointsPerGaussian, footprintCullPx, densityScale, unused
    vec4  bg;      // background rgb, unused
    vec4  camPos;  // world-space camera position, w = measurement-only profile variant
    uvec4 ctrl2;   // resetAccum, shDegree, tonemapMode, unused
    vec4  p3;      // gamma, unused, budgetThin, SH storage stride/channel
    uvec4 ctrl3;   // PBVR3D calibration x/y/z, w = footprint blur compensation
    vec4  p4;      // referencePixelLength, footprint s, adaptive kappa, adaptive s max
} u;

// pass: 0 = depth, 1 = colour, 2 = prepare. ensembleSeed identifies one
// independent ensemble's RNG stream within this frame's dispatch sequence
// (PLAN_pbvr_gps_ensemble_lod.md Phase 1); 0 reproduces the pre-Phase-1 stream
// exactly (see the `pc.ensembleSeed != 0u` guard below).
layout(push_constant) uniform PC { uint pass; uint ensembleSeed; } pc;

const float PI2_6  = 1.6449340668482264;
const float TWO_PI = 6.283185307179586;
const float SH_C1  = 0.4886025119029199;

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
struct RS { uint s; };
float rnd(inout RS r) { r.s = pcg(r.s); return float(r.s) * (1.0 / 4294967296.0); }

uint packLinearColor(vec3 color) {
    vec3 encoded = clamp(log2(max(color, vec3(0.0)) + vec3(1.0)) / 16.0,
                         vec3(0.0), vec3(1.0));
    uvec3 quantized = uvec3(round(encoded * vec3(2047.0, 2047.0, 1023.0)));
    return quantized.x | (quantized.y << 11u) | (quantized.z << 22u);
}

float dilogSeries(float x) {
    float t = x, s = x;
    for (int k = 2; k < 28; ++k) {
        t *= x;
        float a = t / (float(k) * float(k));
        s += a;
        if (a < 1e-8 * abs(s)) break;
    }
    return s;
}
float dilog(float x) {
    x = clamp(x, 0.0, 0.999999);
    if (x <= 0.5) return dilogSeries(x);
    return PI2_6 - log(x) * log(1.0 - x) - dilogSeries(1.0 - x);
}
float invDilog(float target) {
    target = clamp(target, 0.0, PI2_6 - 1e-6);
    if (target <= 0.0) return 0.0;
    float lo = 0.0, hi = 1.0;
    float y = target / PI2_6;
    for (int i = 0; i < 12; ++i) {
        float f = dilog(y) - target;
        if (f > 0.0) hi = y; else lo = y;
        float d = (y > 1e-6 && y < 0.999999) ? (-log(1.0 - y) / y) : 1.0;
        float ny = y - f / d;
        if (!(ny > lo && ny < hi)) ny = 0.5 * (lo + hi);
        y = ny;
    }
    return y;
}
float sampleRadius(float o, float uu) {
    o = clamp(o, 1e-4, 1.0);
    float D = dilog(o);
    float y = min(invDilog((1.0 - uu) * D), o);
    if (y <= 0.0) return 12.0;
    return min(12.0, sqrt(max(0.0, -2.0 * log(y / o))));
}

mat3 quatToR(float w, float x, float y, float z) {
    float il = inversesqrt(max(w*w + x*x + y*y + z*z, 1e-20));
    w *= il; x *= il; y *= il; z *= il;
    return mat3(
        1.0-2.0*(y*y+z*z), 2.0*(x*y+z*w),     2.0*(x*z-y*w),
        2.0*(x*y-z*w),     1.0-2.0*(x*x+z*z), 2.0*(y*z+x*w),
        2.0*(x*z+y*w),     2.0*(y*z-x*w),     1.0-2.0*(x*x+y*y));
}

uint orderedDepthKey(float d) {
    uint b = floatBitsToUint(d);
    uint mask = ((b & 0x80000000u) != 0u) ? 0xFFFFFFFFu : 0x80000000u;
    return b ^ mask;
}

// Linear RGB via SH (3DGS eval_sh). deg 0..3; deg 0 = SH_C0*dc + 0.5.
vec3 evalSH(uint id, vec3 dc, vec3 dir) {
    int deg = int(u.ctrl2.y);
    vec3 result = u.p1.z * dc;
    if (deg >= 1) {
        int R = max(int(u.p3.w), (deg + 1) * (deg + 1) - 1);
        uint base = id * uint(3 * R);
        float x = dir.x, y = dir.y, z = dir.z;
        #define SH(k) vec3(shRest[base + uint(k)], shRest[base + uint(R) + uint(k)], shRest[base + uint(2*R) + uint(k)])
        result += -SH_C1*y*SH(0) + SH_C1*z*SH(1) - SH_C1*x*SH(2);
        if (deg >= 2) {
            float xx=x*x, yy=y*y, zz=z*z, xy=x*y, yz=y*z, xz=x*z;
            result += 1.0925484305920792*xy*SH(3)
                    - 1.0925484305920792*yz*SH(4)
                    + 0.31539156525252005*(2.0*zz-xx-yy)*SH(5)
                    - 1.0925484305920792*xz*SH(6)
                    + 0.5462742152960396*(xx-yy)*SH(7);
            if (deg >= 3) {
                result += -0.5900435899266435*y*(3.0*xx-yy)*SH(8)
                        + 2.890611442640554*xy*z*SH(9)
                        - 0.4570457994644658*y*(4.0*zz-xx-yy)*SH(10)
                        + 0.3731763325901154*z*(2.0*zz-3.0*xx-3.0*yy)*SH(11)
                        - 0.4570457994644658*x*(4.0*zz-xx-yy)*SH(12)
                        + 1.445305721320277*z*(xx-yy)*SH(13)
                        - 0.5900435899266435*x*(xx-3.0*yy)*SH(14);
            }
        }
        #undef SH
    }
    return max(result + 0.5, vec3(0.0));
}

// Variable-footprint points (docs/todo/PLAN_footprint_aware_density_calibration.md Phase 4):
// write the s x s block of subpixels centred on `pixel` -- the cells whose centres lie in
// [c - s/2, c + s/2) with c = pixel * sppSide, clipped to the image (GaussianPointOracle's
// writeBlock). pass 0 = depth atomicMin, otherwise the colour tie-break. Returns whether any
// cell was inside the image. Only used for s > 1; s == 1 keeps the original single write.
bool writeFootprintBlock(vec2 pixel, int s, uint key, uint color, uint pass) {
    int side = int(u.dims.w);
    int gx0 = int(floor(pixel.x * float(side) - 0.5 * float(s) + 0.5));
    int gy0 = int(floor(pixel.y * float(side) - 0.5 * float(s) + 0.5));
    int gw = int(u.dims.x) * side, gh = int(u.dims.y) * side;
    bool any = false;
    for (int gy = max(gy0, 0); gy < min(gy0 + s, gh); ++gy) {
        for (int gx = max(gx0, 0); gx < min(gx0 + s, gw); ++gx) {
            uint idx = (uint(gy / side) * u.dims.x + uint(gx / side)) * u.dims.z
                     + uint((gy % side) * side + (gx % side));
            if (pass == 0u) atomicMin(depthBuf[idx], key);
            else if (depthBuf[idx] == key) atomicMin(colorBuf[idx], color);
            any = true;
        }
    }
    return any;
}

void addExpected(uint value) {
    uint previous = atomicAdd(stats[0], value);
    if (previous > 0xffffffffu-value) atomicAdd(stats[6], 1u);
}
void splatOne(uint id) {
    if (pc.pass == 2u) { prepared[id].count = uvec4(0); offsets[id] = 0u; }
    GsPoint sp = splats[id];

    vec3 world = vec3(sp.x, sp.y, sp.z);
    vec3 cam   = (u.view * vec4(world, 1.0)).xyz;
    float tz   = -cam.z;
    if (tz <= u.p1.x) return;                 // near-plane cull

    float op = 1.0 / (1.0 + exp(-sp.opacity));
    if (op < u.p1.w) return;                  // opacity cull

    float fx = u.p0.x, fy = u.p0.y;

    vec3 sc  = vec3(exp(sp.s0), exp(sp.s1), exp(sp.s2));
    mat3 R   = quatToR(sp.r0, sp.r1, sp.r2, sp.r3);
    mat3 S2  = mat3(sc.x*sc.x, 0, 0,  0, sc.y*sc.y, 0,  0, 0, sc.z*sc.z);
    mat3 cov3 = R * S2 * transpose(R);

    float limx = 1.3 * (0.5 * float(u.dims.x) / fx);
    float limy = 1.3 * (0.5 * float(u.dims.y) / fy);
    float tx = clamp(cam.x / tz, -limx, limx) * tz;
    float ty = clamp(cam.y / tz, -limy, limy) * tz;

    mat3 J = mat3(0.0);
    // Differentiate (fx*x/(-z), -fy*y/(-z)) in the right/up/back view basis.
    // The positive depth tz=-z changes the x derivative with respect to z;
    // image rows grow downward, so the y derivative is negative.
    J[0][0] = fx / tz;  J[2][0] = fx * tx / (tz * tz);
    J[1][1] = -fy / tz; J[2][1] = -fy * ty / (tz * tz);
    mat3 T = J * mat3(u.view);
    mat3 cc3 = T * cov3 * transpose(T);
    float ca = cc3[0][0] + u.p1.y;
    float cb = cc3[0][1];
    float cd = cc3[1][1] + u.p1.y;
    float det = ca * cd - cb * cb;
    if (det <= 1e-9) return;
    float lambdaMax = 0.5 * (ca + cd + sqrt(max((ca - cd) * (ca - cd) + 4.0 * cb * cb, 0.0)));
    // Sub-pixel footprint cull in principal-axis space.
    float cullPx = u.p2.y;
    if (cullPx > 0.0 && lambdaMax < cullPx * cullPx) return;

    float mu =  fx * (cam.x / tz) + u.p0.z;
    float mv = -fy * (cam.y / tz) + u.p0.w;

    // Point footprint s (level F): fixed, or per splat from the projected minor axis
    // (GaussianPointMath::adaptiveFootprint), in subpixels.
    int fp = max(int(u.p4.y), 1);
    if (u.p4.z > 0.0) {
        float lambdaMin = max(0.5 * (ca + cd - sqrt(max((ca - cd) * (ca - cd) + 4.0 * cb * cb, 0.0))), 0.0);
        float s = floor(u.p4.z * sqrt(lambdaMin) * float(u.dims.w));
        fp = int(clamp(s, 1.0, max(u.p4.w, 1.0)));
    }

    // Frustum cull using the full bounded sampling footprint.
    // sampleRadius() is bounded by 12 sigma, so this is conservative for every
    // point the shader can generate, including rotated anisotropic footprints
    // (plus half a footprint block for s > 1).
    float ext = 12.0 * sqrt(lambdaMax) + 0.5 * float(fp - 1) / float(u.dims.w);
    if (mu + ext < 0.0 || mu - ext >= float(u.dims.x) ||
        mv + ext < 0.0 || mv - ext >= float(u.dims.y)) return;

    float bthin = (u.p3.z > 0.0) ? u.p3.z : 1.0;   // point-budget stochastic thinning
    float spp = float(u.dims.z);
    float EN  = spp * TWO_PI * sqrt(det) * dilog(op) * u.p2.z * bthin;
    if (fp > 1) EN /= float(fp * fp);   // each point covers fp^2 subpixels
    EN = min(EN, u.p2.x);

    uint seed = pcg(id * 747796405u + 1u);
    if (u.ctrl.z == 1u || u.ctrl.y != 0u) seed = pcg(seed ^ (u.ctrl.y * 2654435761u + 1u));
    if (pc.ensembleSeed != 0u) seed = pcg(seed ^ (pc.ensembleSeed * 2246822519u + 1u));
    RS rs; rs.s = (seed == 0u) ? 1u : seed;

    int Ni;
    if (u.ctrl.w == 1u) {
        float fl = floor(EN);
        Ni = int(fl) + ((rnd(rs) < (EN - fl)) ? 1 : 0);
    } else if (EN < 30.0) {
        float L = exp(-EN);
        float p = 1.0;
        int k = 0;
        do { k++; p *= rnd(rs); } while (p > L && k < 256);
        Ni = k - 1;
    } else {
        float u1 = max(rnd(rs), 1e-7);
        float g  = sqrt(-2.0 * log(u1)) * cos(TWO_PI * rnd(rs));
        Ni = max(int(round(EN + sqrt(EN) * g)), 0);
    }

    if (Ni <= 0) {
        if (pc.pass == 2u) addExpected(uint(EN * 256.0));
        return;
    }

    // Blur compensation: sample positions from the covariance shrunk by the block's
    // variance (s/side)^2/12 while it stays comfortably SPD; the count above keeps the
    // unshrunk footprint's optical mass.
    if (fp > 1 && u.ctrl3.w != 0u) {
        float v = (float(fp) / float(u.dims.w)) * (float(fp) / float(u.dims.w)) / 12.0;
        float lambdaMin = 0.5 * (ca + cd - sqrt(max((ca - cd) * (ca - cd) + 4.0 * cb * cb, 0.0)));
        if (lambdaMin >= 2.0 * v) { ca -= v; cd -= v; }
    }
    float l00 = sqrt(max(ca, 1e-12));
    float l10 = cb / l00;
    float l11 = sqrt(max(cd - l10 * l10, 1e-12));

    uint dkey = orderedDepthKey(tz);
    vec3 vdir = normalize(world - u.camPos.xyz);
    vec3 lin  = evalSH(id, vec3(sp.f0, sp.f1, sp.f2), vdir);
    uint packed = packLinearColor(lin);

    if (pc.pass == 2u) {
        Prepared q;
        q.a = vec4(mu, mv, l00, l10); q.b = vec4(l11, float(fp), 0, 0);   // b.y = footprint s
        q.c = vec4(0); q.d = vec4(0);
        q.info = vec4(op, 1, 0, 0);
        q.meta = uvec4(rs.s, packed, dkey, 0);
        q.count = uvec4(uint(Ni), 0, 0, 0);
        prepared[id] = q;
        offsets[id] = uint(Ni);
        addExpected(uint(EN * 256.0));

        
        return;
    }
    uint W_ = u.dims.x, H_ = u.dims.y, side = u.dims.w, sppI = u.dims.z;
    uint drawn = 0u;
    uint pointSeed = rs.s;
    for (int i = 0; i < Ni; ++i) {
        rs.s = pcg(pointSeed ^ (uint(i) * 2891336453u + 1u));
        float r  = ((uint(u.camPos.w) & 2u) != 0u) ? sqrt(-2.0 * log(max(rnd(rs), 1e-7)))
                                                   : sampleRadius(op, rnd(rs));   // profile variant bit 2
        float th = TWO_PI * rnd(rs);
        float wx = r * cos(th), wy = r * sin(th);
        float ox = l00 * wx;
        float oy = l10 * wx + l11 * wy;
        float fxp = mu + ox;
        float fyp = mv + oy;
        if (fp > 1) {
            if (writeFootprintBlock(vec2(fxp, fyp), fp, dkey, packed, pc.pass)) drawn++;
            continue;
        }
        if (fxp < 0.0 || fxp >= float(W_) || fyp < 0.0 || fyp >= float(H_)) continue;
        uint px = uint(fxp), py = uint(fyp);
        uint sx = min(uint(fract(fxp) * float(side)), side - 1u);
        uint sy = min(uint(fract(fyp) * float(side)), side - 1u);
        uint sidx = ((py * W_ + px) * sppI) + (sy * side + sx);
        if ((uint(u.camPos.w) & 1u) != 0u) {
            // measurement-only profile variant bit 1: skip the atomics
        } else if (pc.pass == 0u) {
            atomicMin(depthBuf[sidx], dkey);
        } else if (depthBuf[sidx] == dkey) {
            // Atomic colour tie-break makes equal-depth splats deterministic and
            // independent of invocation scheduling and input order.
            atomicMin(colorBuf[sidx], packed);
        }
        drawn++;
    }

    if (pc.pass == 0u) {

        atomicAdd(stats[1], uint(Ni));
        atomicAdd(stats[3], drawn);
    }
}

void main() {
    if (pc.pass != 2u && work[4] != 2u) return;
    uint stride = gl_NumWorkGroups.x * 64u;
    for (uint id = gl_GlobalInvocationID.x; id < u.ctrl.x; id += stride)
        splatOne(id);
}
