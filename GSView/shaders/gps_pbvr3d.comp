#version 450
#extension GL_GOOGLE_include_directive : require
#include "gps_work.glsl"

// PBVR3DExperimental -- object-space "3D Gaussian -> world-space particles".
// Same two-pass depth/colour scatter and the same depth/colour/accum buffers as
// gps_splat.comp, so the two paths are directly comparable
// (docs/todo/PLAN_gsview_gaussian_point_pbvr.md Phase 4).
//
// Particle count per Gaussian (ctrl2.w = method):
//   0 Proportional    N ~ densityScale * sigmoid(o) * baseK           (view-independent)
//   1 Extinction      N ~ densityScale * -log(1-sigmoid(o)) * baseK   (view-independent)
//   2 ViewConditioned generate an extinction-count candidate set, then keep each
//                     particle with probability  gpsTarget / Ncand, where
//                     gpsTarget = spp * 2*pi*sqrt(det Sigma2d) * Li2(o) * densityScale.
//   3 Metropolis      same target count N as Extinction, but positions come from an
//                     independence-sampler Metropolis chain (uniform proposal over a
//                     +/-3-sigma whitened cube, standard Metropolis acceptance against
//                     the Gaussian's own density) instead of direct sampling --
//                     literature-confirmed via kvs::CellByCellMetropolisSampling
//                     (docs/todo/PLAN_pbvr_gps_ensemble_lod.md Phase 5). Always runs
//                     through this shader's own per-splat loop (never gps_compact.comp;
//                     see GaussianPointRenderer::setParams()'s compactPipeline force).
// Positions are regenerated deterministically in both passes. Deterministic seed
// mode reproduces one world-space set; frame-varying mode draws independent sets.
// Persistent cross-frame sample storage is intentionally not claimed here.

layout(local_size_x = 64) in;

struct GsPoint {
    float x, y, z;
    float nx, ny, nz;
    float f0, f1, f2;
    float opacity;
    float s0, s1, s2;
    float r0, r1, r2, r3;
};
layout(std430, binding = 0) readonly buffer InBuf   { GsPoint splats[]; };
layout(std430, binding = 1)          buffer DepthB  { uint  depthBuf[]; };
layout(std430, binding = 2)          buffer ColorB  { uint colorBuf[]; };  // deterministic logarithmic 11/11/10-bit HDR
layout(std430, binding = 4)          buffer StatsB  { uint  stats[]; };
layout(std430, binding = 6) readonly buffer ShRestB { float shRest[]; };

layout(std140, binding = 5) uniform Params {
    mat4  view;
    vec4  p0;      // focalX, focalY, cx, cy
    vec4  p1;      // nearZ, lowPass, shC0, opacityCutoff
    uvec4 dims;    // width, height, spp, sppSide
    uvec4 ctrl;    // numSplats, frameIndex, seedMode, countMode
    vec4  p2;      // maxPointsPerGaussian, footprintCullPx, densityScale, unused
    vec4  bg;
    vec4  camPos;
    uvec4 ctrl2;   // resetAccum, shDegree, tonemapMode, pbvr3dMethod
    vec4  p3;      // gamma, basePointsPerSplat, budgetThin, SH storage stride/channel
} u;

// pass: 0 = depth, 1 = colour, 2 = prepare. ensembleSeed identifies one
// independent ensemble's RNG stream within this frame's dispatch sequence
// (PLAN_pbvr_gps_ensemble_lod.md Phase 1); 0 reproduces the pre-Phase-1 stream
// exactly (see the `pc.ensembleSeed != 0u` guard below).
layout(push_constant) uniform PC { uint pass; uint ensembleSeed; } pc;

const float PI2_6  = 1.6449340668482264;
const float TWO_PI = 6.283185307179586;
const float SH_C1  = 0.4886025119029199;

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
struct RS { uint s; };
float rnd(inout RS r) { r.s = pcg(r.s); return float(r.s) * (1.0 / 4294967296.0); }
uint packLinearColor(vec3 color) {
    vec3 encoded = clamp(log2(max(color, vec3(0.0)) + vec3(1.0)) / 16.0,
                         vec3(0.0), vec3(1.0));
    uvec3 quantized = uvec3(round(encoded * vec3(2047.0, 2047.0, 1023.0)));
    return quantized.x | (quantized.y << 11u) | (quantized.z << 22u);
}
vec2 boxMuller(inout RS r) {
    float u1 = max(rnd(r), 1e-7), u2 = rnd(r);
    float rad = sqrt(-2.0 * log(u1));
    return vec2(rad * cos(TWO_PI * u2), rad * sin(TWO_PI * u2));
}

float dilogSeries(float x) {
    float t = x, s = x;
    for (int k = 2; k < 28; ++k) { t *= x; float a = t / (float(k)*float(k)); s += a; if (a < 1e-8*abs(s)) break; }
    return s;
}
float dilog(float x) {
    x = clamp(x, 0.0, 0.999999);
    if (x <= 0.5) return dilogSeries(x);
    return PI2_6 - log(x) * log(1.0 - x) - dilogSeries(1.0 - x);
}

mat3 quatToR(float w, float x, float y, float z) {
    float il = inversesqrt(max(w*w + x*x + y*y + z*z, 1e-20));
    w *= il; x *= il; y *= il; z *= il;
    return mat3(
        1.0-2.0*(y*y+z*z), 2.0*(x*y+z*w),     2.0*(x*z-y*w),
        2.0*(x*y-z*w),     1.0-2.0*(x*x+z*z), 2.0*(y*z+x*w),
        2.0*(x*z+y*w),     2.0*(y*z-x*w),     1.0-2.0*(x*x+y*y));
}

// Lower-triangular L with L L^T = A (3x3 SPD, column-major A[col][row]).
mat3 chol3(mat3 A) {
    const float eps = 1e-9;
    float l00 = sqrt(max(A[0][0], eps));
    float l10 = A[0][1] / l00;
    float l20 = A[0][2] / l00;
    float l11 = sqrt(max(A[1][1] - l10*l10, eps));
    float l21 = (A[1][2] - l20*l10) / l11;
    float l22 = sqrt(max(A[2][2] - l20*l20 - l21*l21, eps));
    mat3 L = mat3(0.0);
    L[0][0] = l00; L[0][1] = l10; L[0][2] = l20;
    L[1][1] = l11; L[1][2] = l21;
    L[2][2] = l22;
    return L;
}

uint orderedDepthKey(float d) {
    uint b = floatBitsToUint(d);
    uint mask = ((b & 0x80000000u) != 0u) ? 0xFFFFFFFFu : 0x80000000u;
    return b ^ mask;
}

vec3 evalSH(uint id, vec3 dc, vec3 dir) {
    int deg = int(u.ctrl2.y);
    vec3 result = u.p1.z * dc;
    if (deg >= 1) {
        int R = max(int(u.p3.w), (deg + 1) * (deg + 1) - 1);
        uint base = id * uint(3 * R);
        float x = dir.x, y = dir.y, z = dir.z;
        #define SH(k) vec3(shRest[base + uint(k)], shRest[base + uint(R) + uint(k)], shRest[base + uint(2*R) + uint(k)])
        result += -SH_C1*y*SH(0) + SH_C1*z*SH(1) - SH_C1*x*SH(2);
        if (deg >= 2) {
            float xx=x*x, yy=y*y, zz=z*z, xy=x*y, yz=y*z, xz=x*z;
            result += 1.0925484305920792*xy*SH(3) - 1.0925484305920792*yz*SH(4)
                    + 0.31539156525252005*(2.0*zz-xx-yy)*SH(5)
                    - 1.0925484305920792*xz*SH(6) + 0.5462742152960396*(xx-yy)*SH(7);
            if (deg >= 3) {
                result += -0.5900435899266435*y*(3.0*xx-yy)*SH(8) + 2.890611442640554*xy*z*SH(9)
                        - 0.4570457994644658*y*(4.0*zz-xx-yy)*SH(10)
                        + 0.3731763325901154*z*(2.0*zz-3.0*xx-3.0*yy)*SH(11)
                        - 0.4570457994644658*x*(4.0*zz-xx-yy)*SH(12)
                        + 1.445305721320277*z*(xx-yy)*SH(13)
                        - 0.5900435899266435*x*(xx-3.0*yy)*SH(14);
            }
        }
        #undef SH
    }
    return max(result + 0.5, vec3(0.0));
}

// Screen-space 2D covariance (a, b, d) for the projected Gaussian footprint.
vec3 footprintCov2d(vec3 camMean, mat3 cov3) {
    float tz = -camMean.z;
    float fx = u.p0.x, fy = u.p0.y;
    float limx = 1.3 * (0.5 * float(u.dims.x) / fx);
    float limy = 1.3 * (0.5 * float(u.dims.y) / fy);
    float tx = clamp(camMean.x / tz, -limx, limx) * tz;
    float ty = clamp(camMean.y / tz, -limy, limy) * tz;
    mat3 J = mat3(0.0);
    // Same right/up/back -> right/down image projection as gps_splat.comp.
    J[0][0] = fx / tz;  J[2][0] = fx * tx / (tz * tz);
    J[1][1] = -fy / tz; J[2][1] = -fy * ty / (tz * tz);
    mat3 T = J * mat3(u.view);
    mat3 c = T * cov3 * transpose(T);
    return vec3(c[0][0] + u.p1.y, c[0][1], c[1][1] + u.p1.y);
}

void addExpected(uint value) {
    uint previous = atomicAdd(stats[0], value);
    if (previous > 0xffffffffu-value) atomicAdd(stats[6], 1u);
}
void splatOne(uint id) {
    if (pc.pass == 2u) { prepared[id].count = uvec4(0); offsets[id] = 0u; }
    GsPoint sp = splats[id];

    vec3 world = vec3(sp.x, sp.y, sp.z);
    vec3 cam   = (u.view * vec4(world, 1.0)).xyz;
    float tzc  = -cam.z;
    if (tzc <= u.p1.x) return;

    float op = 1.0 / (1.0 + exp(-sp.opacity));
    if (op < u.p1.w) return;

    vec3 sc  = vec3(exp(sp.s0), exp(sp.s1), exp(sp.s2));
    mat3 R   = quatToR(sp.r0, sp.r1, sp.r2, sp.r3);
    mat3 S2  = mat3(sc.x*sc.x, 0, 0,  0, sc.y*sc.y, 0,  0, 0, sc.z*sc.z);
    mat3 cov3 = R * S2 * transpose(R);
    cov3[0][0] = max(cov3[0][0], 1e-9);
    cov3[1][1] = max(cov3[1][1], 1e-9);
    cov3[2][2] = max(cov3[2][2], 1e-9);
    mat3 L3 = chol3(cov3);

    vec3 fc2 = footprintCov2d(cam, cov3);
    float det2d = max(fc2.x * fc2.z - fc2.y * fc2.y, 0.0);
    // Do not cull from the linearised centre footprint here. A 3D Gaussian can
    // cross the near plane and perspective-project far outside that bound; the
    // per-particle viewport test below is the correctness-preserving cull.

    uint method = u.ctrl2.w;
    float dS   = u.p2.z;
    float baseK = u.p3.y * (method == 2u ? 1.0 : u.p2.w);
    float bthin = (u.p3.z > 0.0) ? u.p3.z : 1.0;

    float lambda;      // candidate count
    if (method == 0u)       lambda = dS * op * baseK;
    else                    lambda = dS * (-log(max(1.0 - op, 1e-6))) * baseK;

    // Extinction/ViewConditioned density clamp (opt-in, u.bg.w != 0; PLAN_pbvr_gps_ensemble_lod.md
    // Phase 0, literature-confirmed via kvs::CellByCellSampling::ParticleDensityMap). The extinction
    // formula's -log(1-op) term is unbounded as op->1; the reference implementation clamps the
    // per-volume density at max_density = 1/pixelLength^3, equivalent to capping the candidate count
    // at this splat's own world-space volume divided by pixelLength^3 -- at most ~1 candidate per
    // pixel-footprint-sized volume of the splat's extent. pixelLength uses this splat's own camera-
    // space depth (tzc), not a single frame-wide reference, so the cap is inherently view-dependent
    // (unlike Extinction's base formula) even though Proportional/Extinction were designed to be
    // view-independent -- this option is exempt for method==0 (Proportional never diverges).
    if (method != 0u && u.bg.w != 0.0) {
        float pixelLength = tzc / max(u.p0.x, 1e-6);
        float splatVolume = (4.0 / 3.0) * 3.14159265 * sc.x * sc.y * sc.z;
        float maxCandidates = splatVolume / max(pixelLength * pixelLength * pixelLength, 1e-20);
        lambda = min(lambda, maxCandidates);
    }

    lambda = min(lambda * bthin, u.p2.x);

    // ViewConditioned keep-probability so the on-screen count matches GPS.
    float keepProb = 1.0;
    if (method == 2u) {
        float spp   = float(u.dims.z);
        float gpsTarget = spp * TWO_PI * sqrt(det2d) * dilog(op) * dS * bthin;
        keepProb = (lambda > 0.5) ? clamp(gpsTarget / lambda, 0.0, 1.0) : 0.0;
    }

    uint seed = pcg(id * 747796405u + 1u);
    if (u.ctrl.z == 1u || u.ctrl.y != 0u) seed = pcg(seed ^ (u.ctrl.y * 2654435761u + 1u));
    if (pc.ensembleSeed != 0u) seed = pcg(seed ^ (pc.ensembleSeed * 2246822519u + 1u));
    RS rs; rs.s = (seed == 0u) ? 1u : seed;

    int Ni;
    if (u.ctrl.w == 1u) {
        float fl = floor(lambda);
        Ni = int(fl) + ((rnd(rs) < (lambda - fl)) ? 1 : 0);
    } else if (lambda < 30.0) {
        float Lp = exp(-lambda); float p = 1.0; int k = 0;
        do { k++; p *= rnd(rs); } while (p > Lp && k < 256);
        Ni = k - 1;
    } else {
        vec2 g = boxMuller(rs);
        Ni = max(int(round(lambda + sqrt(lambda) * g.x)), 0);
    }
    if (Ni <= 0) {
        if (pc.pass == 2u) addExpected(uint(lambda * keepProb * 256.0));
        return;
    }

    vec3 vdir = normalize(world - u.camPos.xyz);
    vec3 lin  = evalSH(id, vec3(sp.f0, sp.f1, sp.f2), vdir);
    uint packed = packLinearColor(lin);

    if (pc.pass == 2u) {
        Prepared q;
        q.a = vec4(world, 0); q.b = vec4(L3[0], 0);
        q.c = vec4(L3[1], 0); q.d = vec4(L3[2], 0);
        q.info = vec4(op, keepProb, 0, 0);
        q.meta = uvec4(rs.s, packed, 0, 1);
        q.count = uvec4(uint(Ni), 0, 0, 0);
        prepared[id] = q;
        offsets[id] = uint(Ni);
        addExpected(uint(lambda * keepProb * 256.0));
        atomicAdd(stats[4], uint(Ni));


        return;
    }
    uint W_ = u.dims.x, H_ = u.dims.y, side = u.dims.w, sppI = u.dims.z;
    float fx = u.p0.x, fy = u.p0.y, cx = u.p0.z, cy = u.p0.w;
    uint generated = 0u;
    uint drawn = 0u;
    uint pointSeed = rs.s;

    if (method == 3u) {
        // Metropolis sampling (PLAN_pbvr_gps_ensemble_lod.md Phase 5, literature-confirmed
        // via kvs::CellByCellMetropolisSampling / CellByCellSampling::GridSampler). One
        // sequential independence-sampler chain per splat: uniform proposal over a
        // +/-kSigma cube in whitened (Cholesky) coordinates, accepted/rejected by the
        // ratio of the (unnormalised) Gaussian density exp(-0.5*dot(u,u)) at the trial vs.
        // the current chain state. Deterministically replayed in full from `rs` (seeded
        // above, same as the direct-sampling branch's `pointSeed`) once per pass -- pass 0
        // (depth) and pass 1 (colour) each redo the whole chain rather than persisting
        // state between passes, consistent with this file's existing "positions are
        // regenerated deterministically in both passes" design (see header comment).
        const float kSigma = 3.0;
        const uint maxLoops = uint(Ni) * 10u + 16u;

        vec3 current = vec3((rnd(rs)*2.0-1.0)*kSigma, (rnd(rs)*2.0-1.0)*kSigma, (rnd(rs)*2.0-1.0)*kSigma);
        float densityCur = exp(-0.5 * dot(current, current));
        // Burn-in (KVS's GridSampler::sample(max_loops)): retry until a nonzero-density
        // start is found, or give up after maxLoops attempts. In whitened coordinates with
        // kSigma=3 the Gaussian density never underflows to exactly zero in practice, so
        // this loop is a no-op safety net here rather than a load-bearing warm-up.
        for (uint b = 0u; b < maxLoops && densityCur <= 0.0; ++b) {
            current = vec3((rnd(rs)*2.0-1.0)*kSigma, (rnd(rs)*2.0-1.0)*kSigma, (rnd(rs)*2.0-1.0)*kSigma);
            densityCur = exp(-0.5 * dot(current, current));
        }

        uint counter = 0u, nduplications = 0u;
        for (uint loopI = 0u; loopI < maxLoops && counter < uint(Ni); ++loopI) {
            vec3 trial = vec3((rnd(rs)*2.0-1.0)*kSigma, (rnd(rs)*2.0-1.0)*kSigma, (rnd(rs)*2.0-1.0)*kSigma);
            float densityTrial = exp(-0.5 * dot(trial, trial));
            // Explicit if/else, not `a || b`: GLSL does not guarantee short-circuit
            // evaluation of logical operators, and rnd(rs) here has a side effect
            // (advances the RNG stream) that must only happen on the ratio<1 branch,
            // exactly matching kvs::CellByCellMetropolisSampling's structure where
            // RandomNumber() is called only in the `else` arm.
            bool accept;
            if (densityTrial >= densityCur) accept = true;
            else accept = (densityTrial >= densityCur * rnd(rs));
            if (!accept) {
                nduplications++;
                if (nduplications > maxLoops) break; // give up: fewer than Ni particles for this splat
                continue;
            }
            current = trial; densityCur = densityTrial;
            counter++;
            generated++;

            vec3 pw  = world + L3 * current;
            vec3 pc3 = (u.view * vec4(pw, 1.0)).xyz;
            float pz = -pc3.z;
            if (pz <= u.p1.x) continue;

            float fxp =  fx * (pc3.x / pz) + cx;
            float fyp = -fy * (pc3.y / pz) + cy;
            if (fxp < 0.0 || fxp >= float(W_) || fyp < 0.0 || fyp >= float(H_)) continue;

            uint px = uint(fxp), py = uint(fyp);
            uint sx = min(uint(fract(fxp) * float(side)), side - 1u);
            uint sy = min(uint(fract(fyp) * float(side)), side - 1u);
            uint sidx = ((py * W_ + px) * sppI) + (sy * side + sx);
            uint dkey = orderedDepthKey(pz);
            if (pc.pass == 0u) {
                atomicMin(depthBuf[sidx], dkey);
            } else if (depthBuf[sidx] == dkey) {
                atomicMin(colorBuf[sidx], packed);
            }
            drawn++;
        }
    } else {
        for (int i = 0; i < Ni; ++i) {
            rs.s = pcg(pointSeed ^ (uint(i) * 2891336453u + 1u));
            vec2 ab = boxMuller(rs);
            vec2 cdn = boxMuller(rs);
            vec3 z = vec3(ab.x, ab.y, cdn.x);
            if (method == 2u && rnd(rs) >= keepProb) continue;
            generated++;

            vec3 pw  = world + L3 * z;
            vec3 pc3 = (u.view * vec4(pw, 1.0)).xyz;
            float pz = -pc3.z;
            if (pz <= u.p1.x) continue;

            float fxp =  fx * (pc3.x / pz) + cx;
            float fyp = -fy * (pc3.y / pz) + cy;
            if (fxp < 0.0 || fxp >= float(W_) || fyp < 0.0 || fyp >= float(H_)) continue;

            uint px = uint(fxp), py = uint(fyp);
            uint sx = min(uint(fract(fxp) * float(side)), side - 1u);
            uint sy = min(uint(fract(fyp) * float(side)), side - 1u);
            uint sidx = ((py * W_ + px) * sppI) + (sy * side + sx);
            uint dkey = orderedDepthKey(pz);
            if (pc.pass == 0u) {
                atomicMin(depthBuf[sidx], dkey);
            } else if (depthBuf[sidx] == dkey) {
                atomicMin(colorBuf[sidx], packed);
            }
            drawn++;
        }
    }

    if (pc.pass == 0u) {
        atomicAdd(stats[1], generated);
        atomicAdd(stats[3], drawn);

    }
}

// Reproject one bank entry under the CURRENT camera without resampling its
// world-space position (docs/todo/PLAN_pbvr_gps_ensemble_lod.md Phase 4). Only
// projection and SH colour (both view-dependent) are redone here; entry
// existence/position was already decided when the bank was generated, so this
// intentionally does not re-apply ViewConditioned's keepProb thinning -- that
// was already baked into which candidates exist in the bank.
// pass: 3 = depth, 4 = colour.
void reprojectOne(uint index) {
    vec4 entry = bank[index];
    uint id = floatBitsToUint(entry.w);
    // gps_compact.comp writes this sentinel for a ViewConditioned candidate slot
    // it rejected (reprojectOne iterates every slot up to the pre-thinning total,
    // not just accepted ones) -- skip it exactly as gps_compact.comp's own
    // generate pass would have, instead of reprojecting stale/undefined bank
    // contents as a phantom particle.
    if (id == 0xFFFFFFFFu) return;
    vec3 world = entry.xyz;

    // Already an accepted candidate (thinning was baked in when the bank was
    // generated) -- counts as "generated" the same as gps_compact.comp's
    // generate pass does, once per invocation regardless of this pass's cull.
    if (pc.pass == 3u) atomicAdd(stats[1], 1u);

    vec3 camp = (u.view * vec4(world, 1.0)).xyz;
    float pz = -camp.z;
    if (pz <= u.p1.x) return;

    float fxp =  u.p0.x * (camp.x / pz) + u.p0.z;
    float fyp = -u.p0.y * (camp.y / pz) + u.p0.w;
    if (fxp < 0.0 || fxp >= float(u.dims.x) || fyp < 0.0 || fyp >= float(u.dims.y)) return;

    uint px = uint(fxp), py = uint(fyp), side = u.dims.w, sppI = u.dims.z;
    uint sx = min(uint(fract(fxp) * float(side)), side - 1u);
    uint sy = min(uint(fract(fyp) * float(side)), side - 1u);
    uint sidx = ((py * u.dims.x + px) * sppI) + (sy * side + sx);
    uint dkey = orderedDepthKey(pz);

    if (pc.pass == 3u) {
        atomicMin(depthBuf[sidx], dkey);
        atomicAdd(stats[3], 1u); // drawnPoints: this reused entry landed on screen
    } else if (depthBuf[sidx] == dkey) {
        GsPoint sp = splats[id];
        vec3 vdir = normalize(world - u.camPos.xyz);
        vec3 lin = evalSH(id, vec3(sp.f0, sp.f1, sp.f2), vdir);
        atomicMin(colorBuf[sidx], packLinearColor(lin));
    }
}

void main() {
    if (pc.pass >= 3u) {
        // Bank reuse (Phase 4): iterate the particle count left over from the
        // generation pass that populated bank[] (gps_compact.comp), not numSplats.
        uint count = work[3];
        uint stride = gl_NumWorkGroups.x * 64u;
        for (uint index = gl_GlobalInvocationID.x; index < count; index += stride)
            reprojectOne(index);
        return;
    }
    if (pc.pass != 2u && work[4] != 2u) return;
    uint stride = gl_NumWorkGroups.x * 64u;
    for (uint id = gl_GlobalInvocationID.x; id < u.ctrl.x; id += stride)
        splatOne(id);
}
