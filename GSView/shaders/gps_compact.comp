#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "gps_work.glsl"
layout(std430, binding = 1) buffer DepthB { uint depthBuf[]; };
layout(std430, binding = 2) buffer ColorB { uint colorBuf[]; };
layout(std430, binding = 4) buffer StatsB { uint stats[]; };
layout(std430, binding = 6) readonly buffer ShRestB { float shRest[]; };
layout(std140, binding = 5) uniform Params {
    mat4  view;    // world -> camera (GLM convention: camera looks -Z)
    vec4  p0;      // focalX, focalY, cx, cy        (pixels)
    vec4  p1;      // nearZ, lowPass, shC0, opacityCutoff
    uvec4 dims;    // width, height, spp, sppSide
    uvec4 ctrl;    // numSplats, frameIndex, seedMode, countMode
    vec4  p2;      // maxPointsPerGaussian, footprintCullPx, densityScale, unused
    vec4  bg;      // background rgb, unused
    vec4  camPos;  // world-space camera position, w = measurement-only profile variant
    uvec4 ctrl2;   // resetAccum, shDegree, tonemapMode, unused
    vec4  p3;      // gamma, unused, budgetThin, SH storage stride/channel
    uvec4 ctrl3;   // footprint calibration: level, radial correction, centre depth, unused
    vec4  p4;      // referencePixelLength, unused x3
} u;

layout(push_constant) uniform PC { uint pass; } pc;
#include "gps_sampling.glsl"
// Variable-footprint points (docs/todo/PLAN_footprint_aware_density_calibration.md Phase 4):
// write the s x s block of subpixels centred on `pixel` -- the cells whose centres lie in
// [c - s/2, c + s/2) with c = pixel * sppSide, clipped to the image (GaussianPointOracle's
// writeBlock). pass 0 = depth atomicMin, otherwise the colour tie-break. Returns whether any
// cell was inside the image. Only used for s > 1; s == 1 keeps the original single write.
bool writeFootprintBlock(vec2 pixel, int s, uint key, uint color, uint pass) {
    int side = int(u.dims.w);
    int gx0 = int(floor(pixel.x * float(side) - 0.5 * float(s) + 0.5));
    int gy0 = int(floor(pixel.y * float(side) - 0.5 * float(s) + 0.5));
    int gw = int(u.dims.x) * side, gh = int(u.dims.y) * side;
    bool any = false;
    for (int gy = max(gy0, 0); gy < min(gy0 + s, gh); ++gy) {
        for (int gx = max(gx0, 0); gx < min(gx0 + s, gw); ++gx) {
            uint idx = (uint(gy / side) * u.dims.x + uint(gx / side)) * u.dims.z
                     + uint((gy % side) * side + (gx % side));
            if (pass == 0u) atomicMin(depthBuf[idx], key);
            else if (depthBuf[idx] == key) atomicMin(colorBuf[idx], color);
            any = true;
        }
    }
    return any;
}

vec2 normalPair(inout RS rs) {
    float r = sqrt(-2.0 * log(max(rnd(rs), 1e-7)));
    float t = TWO_PI * rnd(rs);
    return r * vec2(cos(t), sin(t));
}
shared uvec2 totals[64];
void main() {
    // Measurement-only profile variant (GaussianPointRenderer::setProfileVariant, 0 = normal):
    // bit 1 skips the depth/colour atomics, bit 2 swaps the corrected-radius inverse for a
    // plain Gaussian radius. Uniform branch; bit-identical output when 0.
    uint variant = uint(u.camPos.w);
    bool skipAtomics = (variant & 1u) != 0u;
    bool cheapRadius = (variant & 2u) != 0u;
    uvec2 counts = uvec2(0);
    for (uint index = gl_GlobalInvocationID.x; index < work[3]; index += gl_NumWorkGroups.x * 64u) {
        if (pc.pass == 1u && work[4] == 0u) {
            uvec4 v = particles[index];
            uint cachedFp = v.w >> 8u;
            if (cachedFp > 1u) {
                // Footprint block cached as its subpixel origin (+16384 bias, 16 bits each).
                int side = int(u.dims.w);
                vec2 origin = vec2(float(int(v.x & 0xFFFFu) - 16384), float(int(v.x >> 16u) - 16384));
                // Re-derive the same block from its origin: centre = origin + s/2 subpixels.
                vec2 pixel = (origin + 0.5 * float(cachedFp)) / float(side);
                if (!skipAtomics) writeFootprintBlock(pixel, int(cachedFp), v.y, v.z, 1u);
                continue;
            }
            if (!skipAtomics && v.w != 0u && depthBuf[v.x] == v.y) atomicMin(colorBuf[v.x], v.z);
            continue;
        }
        // Upper bound of exclusive offsets handles zero-count primitives.
        uint lo = 0u, hi = u.ctrl.x;
        while (lo < hi) {
            uint mid = lo + (hi-lo)/2u;
            if (offsets[mid] <= index) lo = mid + 1u; else hi = mid;
        }
        uint id = lo - 1u;
        Prepared q = prepared[id];
        RS rs; rs.s = pcg(q.meta.x ^ ((index-offsets[id]) * 2891336453u + 1u));
        if (work[4] == 0u) particles[index] = uvec4(0);
        vec2 pixel;
        uint key = q.meta.z;
        if (q.meta.w == 0u) {
            float r = cheapRadius ? sqrt(-2.0 * log(max(rnd(rs), 1e-7))) : sampleRadius(q.info.x, rnd(rs));
            float t = TWO_PI * rnd(rs);
            vec2 v = r * vec2(cos(t), sin(t));
            pixel = q.a.xy + vec2(q.a.z*v.x, q.a.w*v.x + q.b.x*v.y);
        } else {
            vec2 ab = normalPair(rs), cd = normalPair(rs);
            if (u.ctrl2.w == 2u && rnd(rs) >= q.info.y) {
                // ViewConditioned rejects this candidate slot -- mark it in the
                // bank as empty (Phase 4 bank reuse) so a later reprojection pass
                // knows to skip it. Reprojection iterates every slot up to
                // work[3] (the pre-thinning total, gps_scan.comp), not just the
                // accepted ones, so a rejected slot's bank[] entry must be
                // written explicitly here -- otherwise it keeps whatever was
                // last written there (an earlier ensemble's or epoch's stale
                // world position/id) and gets reprojected as a phantom particle.
                if (pc.pass == 0u && work[4] == 0u) bank[index] = vec4(0.0, 0.0, 0.0, uintBitsToFloat(0xFFFFFFFFu));
                continue;
            }
            vec3 world = q.a.xyz + mat3(q.b.xyz, q.c.xyz, q.d.xyz) * vec3(ab, cd.x);
            // Camera-independent by construction -- written regardless of this
            // ensemble's near-plane cull below, so a reused bank (Phase 4) stays
            // valid for a different camera pose that might not cull it.
            if (pc.pass == 0u && work[4] == 0u) bank[index] = vec4(world, uintBitsToFloat(id));
            vec3 cam = (u.view * vec4(world, 1)).xyz;
            bool front = -cam.z > u.p1.x;
            if (front) {
                pixel = vec2(u.p0.x*cam.x/(-cam.z), -u.p0.y*cam.y/(-cam.z)) + u.p0.zw;
                // C3+R (gps_pbvr3d.comp sets up the Prepared fields): low-pass jitter, then
                // keep by the projected Mahalanobis radius around the splat centre.
                if (u.ctrl3.y != 0u && u.ctrl3.x == 3u && u.ctrl2.w == 1u) {
                    pixel += normalPair(rs) * sqrt(max(u.p1.y, 0.0));
                    vec2 dv = pixel - q.info.zw;
                    float r2 = q.a.w * dv.x * dv.x + 2.0 * q.b.w * dv.x * dv.y + q.c.w * dv.y * dv.y;
                    if (rnd(rs) >= radialKeep(q.info.x, r2)) continue;
                }
            }
            if (pc.pass == 0u) counts.x++;
            if (!front) continue;
            key = (u.ctrl3.z != 0u) ? q.meta.z : orderedDepthKey(-cam.z);
        }
        if (q.meta.w == 0u && pc.pass == 0u) counts.x++;
        int fp = (q.meta.w == 0u) ? max(int(q.b.y), 1) : 1;
        if (fp > 1) {
            if (any(isnan(pixel)) || any(isinf(pixel))) continue;
            int side = int(u.dims.w);
            int gx0 = int(floor(pixel.x * float(side) - 0.5 * float(fp) + 0.5));
            int gy0 = int(floor(pixel.y * float(side) - 0.5 * float(fp) + 0.5));
            // Cache the block origin exactly (the colour pass rebuilds the block from it).
            vec2 centre = (vec2(gx0, gy0) + 0.5 * float(fp)) / float(side);
            bool inside = skipAtomics ? true : writeFootprintBlock(centre, fp, key, q.meta.y, pc.pass);
            if (work[4] == 0u && inside)
                particles[index] = uvec4(uint(gx0 + 16384) | (uint(gy0 + 16384) << 16u), key, q.meta.y,
                                         1u | (uint(fp) << 8u));
            if (pc.pass == 0u && inside) counts.y++;
            continue;
        }
        if (any(isnan(pixel)) || any(isinf(pixel)) || any(lessThan(pixel, vec2(0))) ||
            any(greaterThanEqual(pixel, vec2(u.dims.xy)))) continue;
        uvec2 sub = min(uvec2(fract(pixel)*float(u.dims.w)), uvec2(u.dims.w-1u));
        uint sampleIndex = (uint(pixel.y)*u.dims.x + uint(pixel.x))*u.dims.z + sub.y*u.dims.w + sub.x;
        if (work[4] == 0u) particles[index] = uvec4(sampleIndex, key, q.meta.y, 1u);
        if (pc.pass == 0u) {
            if (!skipAtomics) atomicMin(depthBuf[sampleIndex], key);
            counts.y++;
        } else if (!skipAtomics && depthBuf[sampleIndex] == key) atomicMin(colorBuf[sampleIndex], q.meta.y);
    }
    totals[gl_LocalInvocationID.x] = counts;
    barrier();
    for (uint step = 32u; step > 0u; step >>= 1u) {
        if (gl_LocalInvocationID.x < step) totals[gl_LocalInvocationID.x] += totals[gl_LocalInvocationID.x+step];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0u && pc.pass == 0u) {
        atomicAdd(stats[1], totals[0].x);
        atomicAdd(stats[3], totals[0].y);
    }
}
